{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "model": "nus-llm/qwen-3.7-flash",
  "small_model": "nus-llm/deepseek-v4.1-flash",
  "provider": {
    "nus-llm": {
      "name": "NUS LLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llm.nustechnology.com/v1",
        "drop_params": true,
        "allowed_openai_params": ["reasoning_effort"]
      },
      "models": {
        "deepseek-flash": {
          "name": "deepseek-flash",
          "limit": { "context": 1048576, "output": 384000 },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 1048576, "output": 384000 },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "limit": { "context": 1310720, "output": 131072 },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "mimo-v2.5": {
          "name": "mimo-v2.5",
          "limit": { "context": 1048576, "output": 131072 },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "mimo-v2.5-pro": {
          "name": "mimo-v2.5-pro",
          "limit": { "context": 1048576, "output": 16384 }
        },
        "qwen-3.7-flash": {
          "name": "qwen-3.7-flash",
          "limit": { "context": 1000000, "output": 65536 },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}